<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dimens_15dp">

    <TextView
        android:id="@+id/header_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/pick_auth_method_registration_text_value"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/authMethodList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="@dimen/dimens_15dp"
        android:clickable="true"
        android:focusable="true"
        tools:context=".PickAuthMethodFragment"
        tools:listitem="@layout/fragment_pick_auth_method" />

    <Button
        android:id="@+id/cancel_flow"
        style="@style/ActionButtonStyle"
        android:layout_margin="@dimen/dimens_15dp"
        android:text="@string/cancel_message" />

</LinearLayout>